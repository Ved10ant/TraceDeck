# ─────────────────────────────────────────────────────────────────────────────
# TraceDeck — Docker / Self-hosted Environment Template
# Copy this file to .env.docker and fill in ALL values marked <CHANGE_ME>
# Never commit .env.docker to git (it is gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=tracedeck
POSTGRES_DB=tracedeck
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=<CHANGE_ME>

# ── Redis ─────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REDIS_PASSWORD=<CHANGE_ME>

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<CHANGE_ME>

# ── Worker tuning (optional — defaults shown) ─────────────────────────────────
MAX_CONCURRENT_CHECKS=10
DEFAULT_CHECK_TIMEOUT_MS=10000
