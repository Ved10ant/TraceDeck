# ─────────────────────────────────────────────────────────────────────────────
# TraceDeck — Environment Template
# Copy this file to .env and fill in all values.
# Never commit .env to git (it is gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development          # Change to "production" on hosted services

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<CHANGE_ME>

# ── Database (Neon PostgreSQL or self-hosted) ─────────────────────────────────
# Cloud (Neon):   postgresql://user:pass@host/db?sslmode=require&channel_binding=require
# Self-hosted:    postgresql://tracedeck:PASS@localhost:5432/tracedeck?sslmode=disable
DATABASE_URL=<CHANGE_ME>

# ── Redis (Upstash or self-hosted) ───────────────────────────────────────────
# Cloud (Upstash): rediss://default:TOKEN@host.upstash.io:6379
# Self-hosted:     redis://:REDIS_PASSWORD@localhost:6379
REDIS_URL=<CHANGE_ME>

# ── SSRF Guard ────────────────────────────────────────────────────────────────
# Keep false in all environments. Setting true disables SSRF protection.
ALLOW_PRIVATE_TARGETS=false

# ── Worker Tuning ─────────────────────────────────────────────────────────────
MAX_CONCURRENT_CHECKS=10
DEFAULT_CHECK_TIMEOUT_MS=10000

# ── Next.js Web Dashboard ────────────────────────────────────────────────────
# Local dev:   http://localhost:4000/api/v1
# Production:  https://your-api.railway.app/api/v1  (set in Vercel env vars)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
