# Environment Configuration Example
PORT=4000
NODE_ENV=development
JWT_SECRET=development-super-secret-jwt-key-replace-in-production-min-32-chars

# Database (PostgreSQL)
DATABASE_URL=postgresql://tracedeck:tracedeck@localhost:5432/tracedeck?schema=public

# Queue & Cache (Redis)
REDIS_URL=redis://localhost:6379

# SSRF Safeguards (Set to false in production)
ALLOW_PRIVATE_TARGETS=false

# Worker Settings
MAX_CONCURRENT_CHECKS=10
DEFAULT_CHECK_TIMEOUT_MS=10000
